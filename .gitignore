# Retired pre-revision output tree; canonical derived files now live under
# supplementary/, analysis_stats/, figures/output/, and ignored workflow/results/.
analysis_results/

# Keep the canonical matrix tracked so figures and audits can run from a clone.
# Data symlinks (local paths, not portable)
data/

# Reproducible workflow downloads and derived intermediates
workflow/data/
workflow/resources/
workflow/results/

# Vector PDFs are the canonical publication figures; raster previews are
# generated locally by the same scripts and intentionally not duplicated in Git.
figures/output/*.png

